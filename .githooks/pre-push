#!/usr/bin/env bash
# pre-push: runs on every `git push`. Blocks the push on any failure.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "❌ $*" >&2; exit 1; }
step() { echo "▶ $*"; }

step "demo-go: build"
go build ./... || fail "build failed"

step "demo-go: tests"
TRULAYER_DRY_RUN=true go test ./... || fail "tests failed"

echo "✅ pre-push checks passed"
